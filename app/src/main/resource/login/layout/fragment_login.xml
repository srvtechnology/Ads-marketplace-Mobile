<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:srcCompat="@drawable/ic_login_bg"
        android:scaleY="1.4"
        android:scaleType="fitXY"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:fadingEdge="none"
        android:scrollbars="none">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dimen30dp"
                android:gravity="center_horizontal"
                android:text="@string/municipal_rate_management_system"
                android:textAllCaps="true"
                android:layout_marginTop="@dimen/dimen32dp"
                android:textColor="@color/colorPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="190dp"
                android:layout_height="190dp"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/ic_splash"
                android:layout_marginTop="@dimen/dimen48dp"/>




        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dimen32dp"
            android:layout_marginTop="@dimen/dimen32dp"
            android:background="@drawable/bg_square_blue_border1"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/dimen6dp">
            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etUserName"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Username"
                android:textColor="@color/colorBlack"
                android:inputType="textPersonName"
                android:padding="@dimen/dimen12dp"
                android:textSize="@dimen/textMedium14sp" />
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/dimen24dp"
                android:layout_height="@dimen/dimen24dp"
                android:layout_gravity="center_vertical"
                app:srcCompat="@drawable/ic_name" />
        </androidx.appcompat.widget.LinearLayoutCompat>


        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dimen32dp"
            android:layout_marginTop="@dimen/dimen12dp"
            android:background="@drawable/bg_square_blue_border1"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/dimen6dp">
            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:textColor="@color/colorBlack"
                android:background="@android:color/transparent"
                android:hint="Password"
                android:inputType="textPassword"
                android:padding="@dimen/dimen12dp"
                android:textSize="@dimen/textMedium14sp" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivPassword"
                android:layout_width="@dimen/dimen24dp"
                android:layout_height="@dimen/dimen24dp"
                android:layout_gravity="center_vertical"
                app:srcCompat="@drawable/ic_view" />
        </androidx.appcompat.widget.LinearLayoutCompat>
            <CheckBox
                android:id="@+id/chkboxRememberMe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/textLightGrey"
                android:textSize="@dimen/textMedium14sp"
                android:layout_marginTop="@dimen/dimen8dp"
                android:layout_marginHorizontal="@dimen/dimen32dp"
                android:textStyle="bold"
                android:buttonTint="@color/dark_grey"
                android:text="@string/remember_me"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btLogin"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_below="@+id/tvBelowText"
                android:layout_alignParentEnd="true"
                android:layout_marginHorizontal="@dimen/dimen32dp"
                android:layout_marginTop="@dimen/dimen8dp"
                android:layout_marginBottom="@dimen/dimen12dp"
                android:background="@drawable/bg_btn_login1"
                android:gravity="center"
                android:clickable="true"
                android:padding="@dimen/dimen12dp"
                android:text="Login"
                android:textAllCaps="true"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/textMedium14sp" />

            <TextView
                android:id="@+id/tvForgotPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dimen24dp"
                android:gravity="center_horizontal"
                android:text="Forgot Password"
                android:layout_marginTop="@dimen/dimen20dp"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/textMedium14sp"
                android:textStyle="bold" />
        </androidx.appcompat.widget.LinearLayoutCompat>
    </ScrollView>

    <TextView
        android:id="@+id/tvLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/dimen40dp"
        android:layout_marginBottom="@dimen/dimen24dp"
        android:padding="@dimen/dimen8dp"
        android:layout_centerHorizontal="true"
        android:layout_alignParentBottom="true"
        android:text="@string/new_user"
        android:textSize="@dimen/textSmall12sp" />
</RelativeLayout>