<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:srcCompat="@drawable/ic_login_bg"
        android:scaleType="centerCrop"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <include layout="@layout/toolbar_header_back" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:fadingEdge="none"
        android:scrollbars="none">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:layout_width="@dimen/dimen160dp"
                android:layout_height="@dimen/dimen160dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/dimen48dp"
                android:src="@drawable/ic_splash" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dimen24dp"
                android:gravity="center_horizontal"
                android:text="@string/municipal_rate_management_system"
                android:textAllCaps="true"
                android:layout_marginTop="@dimen/dimen20dp"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/dimen17sp"
                android:textStyle="bold" />


        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dimen32dp"
            android:layout_marginTop="@dimen/dimen32dp"
            android:background="@drawable/bg_square_blue_border1"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/dimen6dp">
            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etUserName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Email"
                android:textColor="@color/colorBlack"
                android:inputType="textPersonName"
                android:padding="@dimen/dimen12dp"
                android:textSize="@dimen/textMedium14sp" />

        </androidx.appcompat.widget.LinearLayoutCompat>




            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvSend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/tvBelowText"
                android:layout_alignParentEnd="true"
                android:layout_marginHorizontal="@dimen/dimen32dp"
                android:layout_marginTop="@dimen/dimen32dp"
                android:layout_marginBottom="@dimen/dimen12dp"
                android:background="@drawable/bg_btn_login1"
                android:gravity="center"
                android:clickable="true"
                android:padding="@dimen/dimen12dp"
                android:text="Send"
                android:textAllCaps="true"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/textMedium14sp" />
        </androidx.appcompat.widget.LinearLayoutCompat>
    </ScrollView>
    </androidx.appcompat.widget.LinearLayoutCompat>
</RelativeLayout>