<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:padding="@dimen/dimen12dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="@dimen/dimen100dp"
        android:layout_height="@dimen/dimen140dp"
        android:scaleType="fitXY"
        app:srcCompat="@drawable/ic_demand_note_pdf"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen8dp"
            android:orientation="horizontal">
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:gravity="center"
                android:text="Year"
                android:textColor="@color/navy_blue"
                android:textSize="@dimen/dimen13sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="@dimen/dimen80dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dimen8dp"
                android:layout_alignParentEnd="true"
                android:background="@drawable/rounded_corner_grey1">

                <androidx.appcompat.widget.AppCompatSpinner
                    android:id="@+id/spnrDemandNoteYear"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/margin_2dp"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="@dimen/dimen24dp"
                    android:layout_height="@dimen/dimen24dp"
                    android:layout_gravity="end|center_vertical"
                    app:srcCompat="@drawable/ic_baseline_arrow_drop_down_24"/>
            </FrameLayout>

        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen8dp"
            android:layout_marginTop="@dimen/dimen6dp"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_gravity="center_vertical"
                android:gravity="center"
                android:text="Status"
                android:textColor="@color/navy_blue"
                android:textSize="@dimen/dimen13sp"
                android:textStyle="bold" />
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:background="@drawable/rounded_corner_grey1"
                android:layout_alignParentEnd="true"
                android:paddingVertical="@dimen/dimen6dp"
                android:gravity="center"
                android:paddingHorizontal="@dimen/dimen8dp"
                android:text="Delivered"
                android:textColor="@color/navy_blue"
                android:textSize="@dimen/dimen13sp"
                android:textStyle="bold" />

        </RelativeLayout>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen8dp"
            android:layout_marginTop="@dimen/dimen6dp"
            android:orientation="horizontal">
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="center"
                android:text="Recipient Name"
                android:textColor="@color/navy_blue"
                android:textSize="@dimen/dimen13sp"
                android:textStyle="bold" />
            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/edtRecipientName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:layout_marginStart="@dimen/dimen12dp"
                android:background="@drawable/rounded_corner_grey1"
                android:paddingVertical="@dimen/dimen4dp"
                android:paddingHorizontal="@dimen/dimen8dp"
                android:textColor="@color/navy_blue"
                android:textSize="@dimen/textSmall12sp"
                android:textStyle="bold" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvDownloadDemandNote"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dimen40dp"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/dimen6dp"
            android:background="@drawable/bg_btn_login"
            android:gravity="center"
            android:paddingHorizontal="@dimen/dimen24dp"
            android:paddingVertical="@dimen/dimen8dp"
            android:text="download demand note"
            android:textAllCaps="true"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/textSmall12sp" />
    </androidx.appcompat.widget.LinearLayoutCompat>

</androidx.appcompat.widget.LinearLayoutCompat>