<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="?attr/actionBarSize"
    android:background="@color/wild_sand">

    <ImageView
        android:id="@+id/toolbar_iv_home"
        android:layout_width="@dimen/dimen32dp"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/dimen8dp"
        android:src="@drawable/ic_back_foreground"
        android:visibility="visible"
        app:tint="@color/dark_grey"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/toolbar_tv_header"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:text="Details"
        android:textColor="@color/dark_grey"
        android:textSize="@dimen/textMedium14sp"
        android:layout_marginStart="@dimen/dimen12dp"
        android:gravity="center_vertical"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/ivProfile"
        app:layout_constraintStart_toEndOf="@+id/toolbar_iv_home"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivProfile"
        android:layout_width="@dimen/dimen24dp"
        android:layout_height="@dimen/dimen24dp"
        android:src="@drawable/ic_name"
        android:layout_marginEnd="@dimen/dimen16dp"
        app:tint="@color/dark_grey"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/ivNotification"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivNotification"
        android:layout_width="@dimen/dimen24dp"
        android:layout_height="@dimen/dimen24dp"
        android:src="@drawable/ic_notification"
        android:layout_marginEnd="@dimen/dimen16dp"
        app:tint="@color/dark_grey"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>