<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorWhite">

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:srcCompat="@drawable/ic_lion_bg" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include layout="@layout/toolbar_header_back" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fadingEdge="none"
            android:scrollbars="none">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dimen24dp"
                    android:layout_marginTop="@dimen/dimen24dp"
                    android:gravity="center_horizontal"
                    android:text="municipal rate management system\nSelf Service portal"
                    android:textAllCaps="true"
                    android:textColor="@color/colorPrimary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen8dp"
                    android:gravity="center_horizontal"
                    android:text="@string/self_service"
                    android:textAllCaps="true"
                    android:textColor="@color/colorPrimary"
                    android:textSize="@dimen/dimen17sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="@dimen/dimen90dp"
                    android:layout_height="@dimen/dimen90dp"
                    android:layout_marginHorizontal="@dimen/dimen24dp"
                    android:layout_marginTop="16dp"
                    android:src="@drawable/ic_splash" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="@string/hi_user_please_enter_your_mobile_number_to_sign_in"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="60dp"
                    android:layout_marginEnd="20dp"
                    android:orientation="horizontal"
                    android:visibility="gone"

                    >

                    <Button
                        android:id="@+id/btCashier"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_login"
                        android:text="@string/cashier"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="13sp"

                        />

                    <View
                        android:layout_width="10dp"
                        android:layout_height="match_parent" />

                    <Button
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_select_blue_button"
                        android:text="@string/user"
                        android:textAllCaps="false"
                        android:textColor="@color/blue_light"
                        android:textSize="13sp" />
                </LinearLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dimen24dp"
                    android:layout_marginTop="@dimen/dimen40dp">

                    <TextView
                        android:id="@+id/tvHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:text="@string/landlord_property_owner_sign_in"
                        android:textAllCaps="true"
                        android:textColor="@color/colorPrimary"
                        android:textSize="@dimen/textSmall12sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/llPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/tvHeader"
                        android:layout_marginTop="@dimen/dimen12dp"
                        android:orientation="horizontal">

                        <com.hbb20.CountryCodePicker
                            android:id="@+id/ccp"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_gravity="center_vertical"
                            android:background="@drawable/bg_square_blue_border"
                            android:gravity="center"
                            app:ccp_defaultNameCode="SL"
                            app:ccp_showNameCode="false"
                            app:ccp_textSize="@dimen/textMedium14sp" />

                        <EditText
                            android:id="@+id/etPhone"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_square_blue_border"
                            android:hint="Mobile Number*"
                            android:inputType="phone"
                            android:maxLength="13"
                            android:paddingStart="10dp"
                            android:textSize="14sp" />
                        <!-- android:text="76100100"-->
                    </LinearLayout>


                    <TextView
                        android:id="@+id/tvBelowText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/llPhone"
                        android:layout_marginStart="@dimen/dimen10dp"
                        android:layout_marginTop="@dimen/dimen10dp"
                        android:text="@string/valid_number_associated_with_your_property_id"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvTimer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/tvBelowText"
                        android:layout_marginStart="@dimen/dimen10dp"
                        android:layout_marginTop="@dimen/dimen10dp"
                        android:text="@string/_0"
                        android:visibility="gone" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/btSendOTP"
                        android:layout_width="@dimen/dimen150dp"
                        android:layout_height="@dimen/dimen40dp"
                        android:layout_below="@+id/tvBelowText"
                        android:layout_alignParentEnd="true"
                        android:layout_marginTop="@dimen/dimen30dp"
                        android:background="@drawable/bg_btn_login"
                        android:gravity="center"
                        android:text="@string/sign_in"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="@dimen/textMedium14sp" />
                </RelativeLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dimen24dp"
                    android:layout_marginTop="@dimen/dimen30dp"
                    android:text="@string/community_engagement_platform"
                    android:textAllCaps="true"
                    android:textColor="@color/colorPrimary"
                    android:textSize="@dimen/textSmall12sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/btCheckIn"
                    android:layout_width="@dimen/dimen150dp"
                    android:layout_height="@dimen/dimen40dp"
                    android:layout_gravity="end"
                    android:layout_marginTop="@dimen/dimen12dp"
                    android:layout_marginEnd="@dimen/dimen24dp"
                    android:background="@drawable/bg_btn_login"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/dimen16dp"
                    android:paddingVertical="@dimen/dimen8dp"
                    android:text="@string/check_in"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/textMedium14sp" />

                <TextView
                    android:id="@+id/tvCashier"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/dimen40dp"
                    android:padding="@dimen/dimen8dp"
                    android:text="@string/cashier_please_click_here_to_sign_in"
                    android:textSize="@dimen/textSmall12sp" />


            </LinearLayout>

        </ScrollView>
    </androidx.appcompat.widget.LinearLayoutCompat>
</FrameLayout>