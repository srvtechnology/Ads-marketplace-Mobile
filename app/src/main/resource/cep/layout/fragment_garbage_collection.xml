<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/colorWhite"
    android:orientation="vertical">

    <include layout="@layout/toolbar_header_back" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fadingEdge="none"
        android:scrollbars="none">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/dimen12dp"
                android:background="@drawable/rounded_corner_grey1"
                android:orientation="vertical"
                android:padding="@dimen/dimen8dp">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/information"
                    android:textAllCaps="true"
                    android:textColor="@color/navy_blue"
                    android:textSize="@dimen/textMedium14sp"
                    android:textStyle="bold" />

                <com.codesgood.views.JustifiedTextView
                    android:id="@+id/tvInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:justificationMode="inter_word"
                    android:text="@string/garbage_collection_info"
                    android:textColor="@color/colorDarkGreen"
                    android:textSize="@dimen/textMedium14sp"
                    android:textStyle="bold" />
            </androidx.appcompat.widget.LinearLayoutCompat>

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dimen12dp"
                android:text="@string/schedule_garbage_collection"
                android:textAllCaps="true"
                android:textColor="@color/navy_blue"
                android:textSize="@dimen/textMedium14sp"
                android:textStyle="bold" />


            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dimen12dp"
                android:layout_marginTop="@dimen/dimen8dp"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:text="@string/pick_up_location"
                    android:textAllCaps="true"
                    android:textColor="@color/dark_grey"
                    android:textSize="@dimen/textMedium14sp"
                    android:textStyle="bold" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/txtLocation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_weight="1"
                    android:background="@drawable/rounded_corner_solid_blue"
                    android:gravity="center"
                    android:paddingVertical="@dimen/dimen8dp"
                    android:text="@string/select_from_digital_address"
                    android:textAllCaps="true"
                    android:textColor="@color/white"
                    android:textSize="@dimen/textSmall12sp"
                    android:textStyle="bold" />
            </androidx.appcompat.widget.LinearLayoutCompat>

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dimen12dp"
                android:layout_marginTop="@dimen/dimen8dp"
                android:text="@string/select_date_amp_time_below"
                android:textAllCaps="true"
                android:textColor="@color/dark_grey"
                android:textSize="@dimen/textSmall12sp"
                android:textStyle="bold" />
            <!--
                        <CalendarView
                            android:id="@+id/calendarView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginTop="@dimen/dimen12dp"
                            android:dateTextAppearance="@style/CalenderViewDateCustomText"
                            android:theme="@style/CalenderViewCustom"
                            android:weekDayTextAppearance="@style/CalenderViewWeekCustomText"
                            android:background="@drawable/rounded_corner_grey2"
                            android:layout_marginHorizontal="@dimen/dimen12dp"/>-->


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageButton
                    android:id="@+id/previousMonthButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:src="@android:drawable/ic_media_previous"
                    app:tint="@color/blue_light" />

                <TextView
                    android:id="@+id/monthYearText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:textColor="@color/blue_light"
                    android:textSize="18sp"
                 />

                <ImageButton
                    android:id="@+id/nextMonthButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:src="@android:drawable/ic_media_next"
                    app:tint="@color/blue_light" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/calendarRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:layout_marginHorizontal="16dp"
                android:background="@drawable/bg_calender"
                android:clipToPadding="false"
                android:padding="16dp"
                android:scrollbars="vertical" />


            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dimen12dp"
                android:layout_marginTop="@dimen/dimen12dp">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/txtPickTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:background="@drawable/rounded_corner_solid_blue"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/dimen24dp"
                    android:paddingVertical="@dimen/dimen8dp"
                    android:text="@string/time"
                    android:textAllCaps="true"
                    android:textColor="@color/white"
                    android:textSize="@dimen/textSmall12sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.LinearLayoutCompat

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:orientation="horizontal">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                      android:visibility="gone"
                        android:id="@+id/rbTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/lightGreen"
                        android:checked="true" />

                    <com.google.android.material.textview.MaterialTextView
                       android:id="@+id/txtSelectedTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginEnd="@dimen/dimen4dp"
                        android:background="@drawable/rounded_corner_grey1"
                        android:gravity="center"
                        android:padding="@dimen/dimen4dp"
                        tools:text="@string/_8am_9am"
                        android:textAllCaps="true"
                        android:textColor="@color/dark_grey"
                        android:textSize="@dimen/textSmall12sp"
                        android:textStyle="bold" />
                </androidx.appcompat.widget.LinearLayoutCompat>
            </RelativeLayout>

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dimen12dp"
                android:layout_marginVertical="@dimen/dimen8dp"
                android:background="@color/lightGray1"
                android:gravity="center"
                android:paddingVertical="@dimen/dimen4dp"
                android:paddingStart="@dimen/dimen12dp"
                android:paddingEnd="@dimen/dimen48dp"
                android:text="@string/images"
                android:textAllCaps="true"
                android:textColor="@color/colorBlack"
                android:textSize="@dimen/textSmall12sp"
                android:textStyle="bold" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivCepImage1"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dimen140dp"
                        android:layout_marginTop="@dimen/dimen6dp"
                        android:layout_marginHorizontal="@dimen/dimen12dp"
                        android:background="@drawable/dash_image_placeholder1"
                        android:padding="@dimen/dimen20dp"
                        app:srcCompat="@drawable/ic_capture_image" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tvTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginVertical="@dimen/dimen8dp"
                        android:text="@string/capture_image"
                        android:textAllCaps="true"
                        android:textColor="@color/colorBlack"
                        android:textSize="@dimen/textSmall12sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivCepImage2"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dimen140dp"
                        android:layout_marginTop="@dimen/dimen6dp"
                        android:layout_marginHorizontal="@dimen/dimen12dp"
                        android:background="@drawable/dash_image_placeholder1"
                        android:padding="@dimen/dimen20dp"
                        app:srcCompat="@drawable/ic_capture_image" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tvTitle2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginVertical="@dimen/dimen8dp"
                        android:text="@string/capture_image"
                        android:textAllCaps="true"
                        android:textColor="@color/colorBlack"
                        android:textSize="@dimen/textSmall12sp"
                        android:textStyle="bold" />
                </LinearLayout>


            </LinearLayout>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/btnSubmit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/dimen40dp"
                android:layout_marginBottom="@dimen/dimen48dp"
                android:background="@drawable/rounded_corner_solid_green"
                android:gravity="center"
                android:paddingHorizontal="@dimen/dimen32dp"
                android:paddingVertical="@dimen/dimen8dp"
                android:text="@string/schedule_collection"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:textSize="@dimen/textSmall12sp"
                android:textStyle="bold" />
        </androidx.appcompat.widget.LinearLayoutCompat>
    </ScrollView>
</androidx.appcompat.widget.LinearLayoutCompat>