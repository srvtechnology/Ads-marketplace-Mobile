<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorWhite"
    android:orientation="vertical">

    <include layout="@layout/toolbar_header_back" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none"
        android:fadingEdge="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivCouncilImage"
                android:layout_width="match_parent"
                android:layout_height="@dimen/margin_220dp"
                android:layout_marginTop="@dimen/dimen20dp"
                 />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvWelcomeText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dimen16dp"
                android:layout_marginTop="@dimen/dimen20dp"
                android:fontFamily="@font/great_vibes_regular"
                android:gravity="center_horizontal"
                android:text="@string/welcome_to"
                android:textColor="@color/colorBlack"
                android:textSize="@dimen/dimen32sp"
                android:textStyle="bold" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dimen16dp"
                android:layout_marginTop="@dimen/dimen20dp"
                android:gravity="center_horizontal"
                android:text="@string/dummy_address"
                android:textColor="@color/gray_text_color"
                android:textSize="@dimen/textMedium14sp"
                android:textStyle="bold" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dimen16dp"
                android:gravity="center_horizontal"
                android:text="Telephone: +23276000000"
                android:textColor="@color/gray_text_color"
                android:textSize="@dimen/textMedium14sp"
                android:textStyle="bold" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dimen16dp"
                android:gravity="center_horizontal"
                android:text="E-Mail - info@koinadugudc.gov.sl"
                android:textColor="@color/gray_text_color"
                android:textSize="@dimen/textMedium14sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimen300dp"
                android:layout_marginHorizontal="@dimen/dimen16dp"
                android:layout_marginTop="@dimen/dimen20dp"
                >

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="@dimen/dimen16dp"
                    android:scaleType="centerCrop"
                    app:srcCompat="@drawable/ic_council_lion_bg" />

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.4"
                            android:text="@string/ward_colon"
                            android:textAllCaps="true"
                            android:textColor="@color/gray_text_color"
                            android:textSize="@dimen/textMedium14sp"
                            android:textStyle="bold" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/tvWard"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.6"
                            android:gravity="end"
                            android:text="121 - 143"
                            android:textColor="@color/gray_text_color"
                            android:textSize="@dimen/textMedium14sp"
                            android:textStyle="bold" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.4"
                            android:text="@string/constituencies_colon"
                            android:textAllCaps="true"
                            android:textColor="@color/gray_text_color"
                            android:textSize="@dimen/textMedium14sp"
                            android:textStyle="bold" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/tvConstituencies"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.6"
                            android:gravity="end"
                            android:text="82 - 91"
                            android:textColor="@color/gray_text_color"
                            android:textSize="@dimen/textMedium14sp"
                            android:textStyle="bold" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.4"
                            android:text="@string/district_colon"
                            android:textAllCaps="true"
                            android:textColor="@color/gray_text_color"
                            android:textSize="@dimen/textMedium14sp"
                            android:textStyle="bold" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/tvDistrict"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.6"
                            android:gravity="end"
                            android:textAllCaps="true"
                            android:text="10 - 40"
                            android:textColor="@color/gray_text_color"
                            android:textSize="@dimen/textMedium14sp"
                            android:textStyle="bold" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/dimen20dp"
                        android:orientation="horizontal">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.4"
                            android:text="@string/province_colon"
                            android:textAllCaps="true"
                            android:textColor="@color/gray_text_color"
                            android:textSize="@dimen/textMedium14sp"
                            android:textStyle="bold" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/tvProvince"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.6"
                            android:gravity="end"
                            android:textAllCaps="true"
                            android:text="Northern Province"
                            android:textColor="@color/gray_text_color"
                            android:textSize="@dimen/textMedium14sp"
                            android:textStyle="bold" />
                    </androidx.appcompat.widget.LinearLayoutCompat>


                </androidx.appcompat.widget.LinearLayoutCompat>
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvContinue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginTop="@dimen/dimen48dp"
                    android:layout_marginBottom="@dimen/dimen48dp"
                    android:background="@drawable/rounded_corner_solid_green"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/dimen32dp"
                    android:paddingVertical="@dimen/dimen12dp"
                    android:text="@string/continue_dot"
                    android:textColor="@color/white"
                    android:textSize="@dimen/dimen16sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>


    </ScrollView>
</LinearLayout>