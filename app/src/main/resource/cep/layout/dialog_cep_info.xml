<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/transparent">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/dimen12dp"
        android:background="@drawable/rounded_corner_grey_border">

        <com.codesgood.views.JustifiedTextView
            android:id="@+id/tvInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/check_in_info"
            android:textColor="@color/textLightGrey"
            android:textStyle="bold"
            android:textSize="@dimen/dimen16sp"
            android:justificationMode="inter_word"/>

        <AutoCompleteTextView
            android:id="@+id/etSelectArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen16dp"
            android:background="@drawable/bg_square_blue_border1"
            android:hint="Enter Area"
            android:textColorHint="@color/gray_text_color"
            android:textColor="@color/colorBlack"
            android:inputType="text"
            android:padding="@dimen/dimen8dp"
            android:textSize="@dimen/textMedium14sp" >
            <requestFocus />
        </AutoCompleteTextView>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginTop="@dimen/dimen16dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/rounded_corner_grey1">

                <androidx.appcompat.widget.AppCompatSpinner
                    android:id="@+id/spnrDistrict"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="@dimen/dimen4dp" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="@dimen/dimen32dp"
                    android:layout_height="@dimen/dimen32dp"
                    android:layout_gravity="end|center_vertical"
                    app:srcCompat="@drawable/ic_baseline_arrow_drop_down_24" />
            </FrameLayout>


        <CheckBox
            android:id="@+id/chkboxSetDefault"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/textLightGrey"
            android:textSize="@dimen/textMedium14sp"
            android:layout_marginTop="@dimen/dimen16dp"
            android:textStyle="bold"
            android:text="@string/set_as_default_council"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/dimen16dp">
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/rounded_corner_solid_red"
            android:gravity="center"
            android:paddingVertical="@dimen/dimen12dp"
            android:layout_marginEnd="@dimen/dimen8dp"
            android:text="Cancel"
            android:textAllCaps="true"
            android:textColor="@color/white"
            android:textSize="@dimen/textSmall12sp"
            android:textStyle="bold" />
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/btnContinue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_horizontal"
            android:layout_marginStart="@dimen/dimen8dp"
            android:background="@drawable/rounded_corner_solid_green1"
            android:gravity="center"
            android:paddingVertical="@dimen/dimen12dp"
            android:text="Continue"
            android:textAllCaps="true"
            android:textColor="@color/white"
            android:textSize="@dimen/textSmall12sp"
            android:textStyle="bold" />
    </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>

</FrameLayout>