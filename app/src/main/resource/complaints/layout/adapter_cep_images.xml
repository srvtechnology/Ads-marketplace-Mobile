<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/llImages"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivCepImage"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen140dp"
        android:layout_marginTop="@dimen/dimen6dp"
        android:layout_marginHorizontal="@dimen/dimen12dp"
        android:background="@drawable/dash_image_placeholder1"
        android:padding="@dimen/dimen20dp"
        app:srcCompat="@drawable/ic_capture_image" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginVertical="@dimen/dimen8dp"
        android:text="@string/capture_image"
        android:textAllCaps="true"
        android:textColor="@color/colorBlack"
        android:textSize="@dimen/textSmall12sp"
        android:textStyle="bold" />

</androidx.appcompat.widget.LinearLayoutCompat>